# Copy this file to .env and fill in real values before running the server.

# Port the Node server listens on. Put a reverse proxy (nginx/Caddy) with TLS
# in front of this for your real domain.
PORT=8080

# Docker only: the port exposed on the HOST machine (docker-compose.yml
# maps this -> the container's internal 8080). Change this if 8080 is
# already taken on your host — common on shared boxes like Pterodactyl,
# where a game server's port allocation can collide with it. The internal
# PORT above does not need to change. If you change this, also update
# your reverse proxy to point at the new port instead of 8080.
#HOST_PORT=8080

# Public URL players will be sent to (must match your domain + reverse proxy).
# No trailing slash.
PUBLIC_BASE_URL=https://prefix.yourdomain.com

# Shared secret the Velocity plugin must send as the X-API-Key header on
# every plugin-facing request. Generate something long and random, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# This MUST match backend.apiKey in the plugin's config.properties.
BACKEND_API_KEY=CHANGE_ME_TO_A_LONG_RANDOM_VALUE

# How long a generated link stays valid, in minutes.
SESSION_TTL_MINUTES=20

# Max raw characters a saved prefix string can be. LuckPerms stores it
# wrapped as "prefix.<priority>.<value>" in a single database column that
# defaults to VARCHAR(200) on MySQL/MariaDB — 160 leaves ~40 chars of
# headroom under that. Raising this is safe up to ~185 or so against an
# unmodified default schema; beyond that you're gambling unless you've
# actually widened that column yourself. Note MiniMessage-format gradients
# barely use this budget at all even for long text (unlike legacy hex,
# which repeats a color code per letter) — if you want longer *visible*
# gradient words, picking MiniMessage on the build page is the real fix,
# not raising this number.
#MAX_PREFIX_LENGTH=160

# Optional: override the session TTL in milliseconds for automated testing
# only (e.g. 2000 for a 2 second TTL). Leave unset in production.
#TEST_TTL_MS=

# Login for the admin audit log page (https://yourdomain/admin.html) —
# completely separate credential from BACKEND_API_KEY above, so admins
# never need to know/paste the plugin's shared secret. Leave either unset
# and the admin login route will refuse to work until both are set. Pick
# your own username; generate a real password rather than typing one, e.g.:
#   node -e "console.log(require('crypto').randomBytes(18).toString('base64url'))"
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_VALUE
